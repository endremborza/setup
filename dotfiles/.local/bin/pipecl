#! /bin/sh
case "$(basename "$0")" in
    pipeclf) MODEL=claude-fable-5 ;;
    *) MODEL=claude-opus-4-8 ;;
esac
_cl() { claude --effort xhigh --model "$MODEL" --permission-mode auto; }
if [ "$1" = "--raw" ]; then
    echo "$2" | _cl
else
    [ -f "$1" ] || { echo "File not found: $1" >&2; exit 1; }
    cat "$1" | _cl
fi
