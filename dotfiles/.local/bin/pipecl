#! /bin/sh
case "$(basename "$0")" in
    pipeclf) MODEL=claude-fable-5 ;;
    *) MODEL=claude-opus-5 ;;
esac
CL="env -u ANTHROPIC_API_KEY claude --effort xhigh --model $MODEL --permission-mode auto"
if [ "$1" = "--safe" ]; then
    shift
    CL="$CL --safe-mode"
fi
if [ "$1" = "--interactive" ]; then
    shift
    _cl() { $CL; }
else
    _cl() { timeout -k 10 "${PIPECL_TIMEOUT:-10800}" $CL -p; }
fi
if [ "$1" = "--raw" ]; then
    echo "$2" | _cl
else
    [ -f "$1" ] || { echo "File not found: $1" >&2; exit 1; }
    cat "$1" | _cl
fi
