FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/bin:/root/.cargo/bin:${PATH}"

# bootstrap.sh installs curl/git/stow/make itself through sudo, so sudo (and a
# passwordless rule) must exist before it runs.
RUN apt-get update && apt-get install -y sudo curl git && \
    rm -rf /var/lib/apt/lists/* && \
    echo 'root ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers

# Stage the diencephalon repo as a local clone source for bootstrap.sh.
COPY . /tmp/diencephalon-src

# End-to-end: git clone to the canonical layout, blocking files moved aside,
# restow, make setup-run.
RUN DIENCEPHALON_URL=/tmp/diencephalon-src bash /tmp/diencephalon-src/setup/bootstrap.sh

# Independent verify (PROFILES= → just base).
WORKDIR /root/synced/composites/pkm/diencephalon
RUN make setup-verify PROFILES=
